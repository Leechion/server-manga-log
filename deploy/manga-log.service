# 漫画志 systemd 服务（Linux 服务器开机自启、崩溃自动拉起）
# 用法：
#   1. 把整个 server-manga-log 目录放到服务器，比如 /opt/server-manga-log
#   2. 修改下面 WorkingDirectory 与 Environment=ACCESS_CODE=（务必改口令！）
#   3. sudo cp manga-log.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now manga-log
#   4. 看日志：journalctl -u manga-log -f

[Unit]
Description=Server Manga Log (服务器改动·漫画志)
After=network.target

[Service]
Type=simple
# ★ 改成你的实际目录
WorkingDirectory=/opt/server-manga-log
ExecStart=/usr/bin/node server.js
# ★ 0.0.0.0 = 允许外部访问；只在内网用就改成 127.0.0.1
Environment=HOST=0.0.0.0
Environment=PORT=4780
# ★★ 必改：外网访问一定要设口令，否则谁都能改你的记录！
Environment=ACCESS_CODE=change-me-please
# 同机隧道/反代（cloudflared、frpc、本机 nginx）无需额外配置：
# 转发头只在 TCP 对端为回环/内网时才被采信，公网直连伪造 XFF 无效。
# 反向代理部署在另一台机器时才需要下一行，并同时用防火墙限制 4780 只允许代理机直连：
#Environment=TRUST_PROXY=1
# 外层是 HTTPS 隧道/反代时打开：会话 Cookie 加 Secure
#Environment=SECURE_COOKIE=1
# 多人共用：在 config.json 里写 "users": [{"name":"alice","code":"口令"}] 即进入多用户模式，
# 每人登录自己的账号、只看自己的记录（数据隔离在 users/<用户名>/，多用户模式忽略 ACCESS_CODE）。
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
